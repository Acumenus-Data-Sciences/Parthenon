# Parthenon Platform Configuration
APP_ENV=local
DB_PASSWORD=secret

# Shared internal service token (php ↔ parthenon-templates sidecar). REQUIRED:
# docker compose aborts every command until this is set. Generate any random
# string, e.g. `openssl rand -hex 32`. The installer auto-generates one.
PARTHENON_INTERNAL_TOKEN=change-me-to-a-random-token

# Read-only analytics user (abby_analyst) used by the AI service for
# DATABASE_URL and GIS_DATABASE_URL, and by the Laravel 'interrogation'
# connection. The installer auto-generates this; Laravel's abby:setup-analyst
# artisan command creates/updates the PG role with this password.
ABBY_ANALYST_PASSWORD=

# --- Default-service credentials (docker compose interpolates these from the
# ROOT .env at container creation; without them reverb/orthanc/hecate/jupyterhub
# come up blank-credentialed). The installer auto-generates real values. ---

# Reverb (WebSocket server for Abby streaming + agent copilots, Commons realtime)
REVERB_APP_ID=parthenon-commons
REVERB_APP_KEY=parthenon-local-reverb-key
REVERB_APP_SECRET=parthenon-local-reverb-secret
REVERB_PORT=8080

# Orthanc (DICOM PACS) admin password
ORTHANC_PASSWORD=change-me-orthanc

# Hecate (vocabulary search) — reuses the parthenon Postgres role/password
HECATE_PG_PASSWORD=secret

# JupyterHub (notebook workspaces)
JUPYTER_JWT_SECRET=change-me-generate-a-real-secret
JUPYTERHUB_CRYPT_KEY=change-me-generate-32-byte-hex
JUPYTER_HUB_API_KEY=change-me-generate-a-real-api-key
JUPYTER_DB_RESEARCHER_PASSWORD=jupyter_researcher_pass
JUPYTER_DB_ADMIN_PASSWORD=jupyter_admin_pass

# Host port mapping (change to avoid conflicts)
NGINX_PORT=8082
VITE_PORT=5175
POSTGRES_PORT=5480
REDIS_PORT=6381
AI_PORT=8002
JUPYTER_PORT=8888
JUPYTER_TOKEN=parthenon-local-jupyter

# Ollama (local LLM for Abby and AI concept mapping)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=puyangwang/medgemma-27b-it:q4_0
# Separate Ollama endpoint for embedding model (can point to same host, different port)
OLLAMA_EMBED_BASE_URL=http://host.docker.internal:11434
ABBY_OLLAMA_BASE_URL=http://host.docker.internal:11434
ABBY_OLLAMA_MODEL=puyangwang/medgemma-27b-it:q4_0
# Ollama session keepalive (seconds)
ABBY_OLLAMA_KEEP_ALIVE=3600
ABBY_CLOUD_ROUTING_ENABLED=false
# Ordinary Abby chat stays local. Study Design Compiler protocol evaluation is
# an explicit Abby-scoped cloud path for research-grade protocol analysis.
ABBY_PROTOCOL_CLOUD_EVALUATION_ENABLED=true

# HuggingFace token for gated model downloads (leave blank if not using gated models)
HF_TOKEN=

# Anthropic Claude API (used by the Abby-scoped Study Design Compiler
# protocol evaluator when ABBY_PROTOCOL_CLOUD_EVALUATION_ENABLED=true)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_TIMEOUT=60

# AI safety & budget guardrails
PHI_DETECTION_ENABLED=true
CLOUD_MONTHLY_BUDGET_USD=500

# Agent copilot provider (Studies/Publish/Abby on the Claude Agent SDK).
# EE = Anthropic cloud (default); CE = a local model via the claude-router proxy.
# Defaults below preserve EE behavior — set AGENT_PROVIDER=local and run the
# sidecar (docker compose --profile ce up -d claude-router python-ai) for CE.
# Requires Ollama to have AGENT_LOCAL_MODEL pulled. Keep actions disabled until
# the chosen local model proves reliable tool-calling.
AGENT_PROVIDER=anthropic
AGENT_LOCAL_BASE_URL=http://claude-router:8787
AGENT_LOCAL_MODEL=qwen2.5-coder:32b
AGENT_LOCAL_AUTH_TOKEN=local
AGENT_LOCAL_ACTIONS_ENABLED=false
AGENT_LOCAL_EFFORT=medium

# FinnGen (SP1 foundation)
FINNGEN_PG_RO_PASSWORD=replace_me_with_strong_password
FINNGEN_PG_RW_PASSWORD=replace_me_with_strong_password
FINNGEN_DARKSTAR_URL=http://darkstar:8787
FINNGEN_ARTIFACTS_PATH=/opt/finngen-artifacts

# Managed OHDSI Shiny runtime
SHINY_PROXY_PORT=3839
SHINY_PROXY_DOCKER_GID=984
PARTHENON_DARKSTAR_IMAGE=ghcr.io/acumenus-data-sciences/parthenon-darkstar:latest
PARTHENON_SHINY_APP_IMAGE=ghcr.io/acumenus-data-sciences/parthenon-shiny-ohdsi:latest
PARTHENON_SHINY_MAX_INSTANCES=6
PARTHENON_SHINY_MAX_LIFETIME_MINUTES=240
PARTHENON_SHINY_APP_MEMORY=4G
PARTHENON_SHINY_APP_CPU=2

# Phase 14 regenie container resource limits (D-23)
# Biobank-scale default (8g/4cpu) fits PANCREAS (~361 cases) with margin.
# Override upward for UK-Biobank-scale deployments (e.g., 16g/8cpu).
REGENIE_MEM_LIMIT=8g
REGENIE_CPU_LIMIT=4
