# Hypertension v3 study runner config
# Copy to scripts/htn-v3/.env and fill in. Never commit the populated file.
# chmod 600 scripts/htn-v3/.env after creating.

# Production API base (no trailing slash)
API_BASE=https://parthenon.acumenus.net/api/v1

# Study slug (already exists in production)
STUDY_SLUG=hypertension-study-v3-2

# Acumenus OMOP CDM source key (resolves to source_id at runtime)
SOURCE_KEY=ACUMENUS

# Runner identity (email of the account whose Sanctum token will be minted per phase).
# The script mints a short-lived (60 min) Sanctum token at phase start and revokes it on exit.
# No token is ever written to disk.
RUNNER_EMAIL=admin@acumenus.net
