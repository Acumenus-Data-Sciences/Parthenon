# Phase 19 GIS loader environment configuration
# Copy to scripts/gis/.env (gitignored) and source before running loaders.

# -----------------------------------------------------------------------------
# Database connection (D-04, GIS-04)
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=parthenon
PGUSER=parthenon_migrator

# Password resolution: NEVER set PGPASSWORD here. Use ~/.pgpass:
#   localhost:5432:parthenon:parthenon_migrator:<the-password>
#   chmod 600 ~/.pgpass
# OR set PGPASSFILE to a custom location.
# PGPASSFILE=/path/to/custom/pgpass

# -----------------------------------------------------------------------------
# Loader behavior
# -----------------------------------------------------------------------------
# User id used when stamping app.gis_imports rows. Defaults to admin@acumenus.net (id=117).
PARTHENON_LOADER_USER_ID=117

# -----------------------------------------------------------------------------
# Source data file paths (overrides — defaults are repo-relative)
# -----------------------------------------------------------------------------
# 2020 Census Urban Area county dataset (3,234 rows, main sheet only)
PHASE_19_UA_XLSX_PATH=/home/smudoshi/Github/Parthenon/2020_UA_COUNTY.xlsx

# HUD USPS-Tract crosswalk (March 2020 — pairs with 2020 UA decennial)
PHASE_19_HUD_CROSSWALK=/home/smudoshi/Github/Parthenon/GIS/data/crosswalk/TRACT_ZIP_032020.xlsx

# Optional: TIGER 2020 county shapefile for geometry column. If unset/missing
# the loader inserts gis.geographic_location rows with NULL geometry.
# PHASE_19_TIGER_COUNTY_SHP=/home/smudoshi/Github/Parthenon/GIS/data/tiger/tl_2020_us_county.shp
